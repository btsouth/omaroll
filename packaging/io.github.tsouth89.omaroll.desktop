[Desktop Entry]
Type=Application
Name=Omaroll
GenericName=Media Library
Comment=A fast, beautiful image, video, and PDF viewer
Exec=omaroll %f
Icon=io.github.tsouth89.omaroll
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/avif;image/heic;image/heif;image/tiff;image/svg+xml;image/svg+xml-compressed;image/vnd.microsoft.icon;image/jxl;image/jp2;image/x-jp2-codestream;image/qoi;image/vnd.adobe.photoshop;image/vnd.ms-dds;image/x-exr;image/x-tga;video/mp4;video/x-m4v;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-ms-wmv;video/x-flv;video/mpeg;video/ogg;video/3gpp;video/mp2t;application/pdf;inode/directory;
Keywords=media;photo;video;pdf;document;screenshot;recording;capture;gallery;library;album;tag;
StartupNotify=true
StartupWMClass=io.github.tsouth89.omaroll
