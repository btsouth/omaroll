pkgname=omaroll
pkgver=@VERSION@
pkgrel=1
pkgdesc='A fast, beautiful image and video viewer for Omarchy'
arch=('x86_64')
url='https://github.com/tsouth89/omaroll'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-imageformats'
         'kimageformats' 'libavif' 'libheif' 'hicolor-icon-theme'
         'xdg-desktop-portal' 'ffmpegthumbnailer' 'wl-clipboard' 'xdg-utils')
optdepends=('omacut: trim recordings'
            'tensaku: annotate screenshots'
            'tesseract: copy text out of a screenshot'
            'zbar: scan QR codes'
            'pinta: edit images'
            'mpv: play video'
            'imv: view images full size'
            'localsend: send to another device')
makedepends=('cmake' 'ninja' 'pkgconf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/tsouth89/omaroll/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
